{
  "name": "jarvis-os",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/web"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --config apps/web/vite.config.ts --host 127.0.0.1",
    "api": "node --env-file-if-exists=.env apps/api/src/main.ts",
    "password": "node scripts/password.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "test:e2e": "node tests/browser.mjs",
    "build": "vite build --config apps/web/vite.config.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "setup": "node scripts/setup.mjs",
    "start": "node scripts/start.mjs",
    "test:launcher": "node --test tests/launcher-smoke.mjs",
    "start:built": "node scripts/serve-built.mjs",
    "test:e2e:built": "node tests/browser.mjs --built"
  },
  "dependencies": {
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@types/node": "24.7.2",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "playwright": "1.55.1",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
