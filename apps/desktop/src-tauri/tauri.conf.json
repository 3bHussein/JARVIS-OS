{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JARVIS OS Desktop Preview",
  "version": "0.1.0",
  "identifier": "com.jarvisos.personal.preview",
  "build": { "frontendDist": "../bootstrap" },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "capabilities": [],
