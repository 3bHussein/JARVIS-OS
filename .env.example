# Local personal-development authentication. Generate a hash with npm run password.
JARVIS_PASSWORD_HASH=
JARVIS_ORIGIN=http://127.0.0.1:5173
JARVIS_PORT=4310
# Optional server-only fine-grained token: selected personal repositories, read only.
GITHUB_TOKEN=
# Optional separately installed LOCAL Ollama model (no automatic install/pull).
# Set OLLAMA_NO_CLOUD=1 in the Ollama service's own environment before running it.
# Leave blank for deterministic commands only. Restart JARVIS after changing.
JARVIS_OLLAMA_MODEL=
